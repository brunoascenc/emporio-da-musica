# Local development values only. Copy to backend/.env before starting Compose.
APP_NAME=Emporio da Musica API
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=emporio
POSTGRES_USER=emporio
POSTGRES_PASSWORD=emporio_local_password

# Required only for policy embedding and retrieval. Never commit the actual key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
